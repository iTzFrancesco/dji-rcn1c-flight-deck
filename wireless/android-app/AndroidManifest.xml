<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.drone.rcn1cbridge"
    android:versionCode="12"
    android:versionName="3.3.0-beta1">

    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <queries>
        <package android:name="moe.shizuku.privileged.api"/>
        <package android:name="com.Orqa.FPVSkyDive"/>
        <package android:name="com.FullFocusStudio.FeelFPV"/>
    </queries>

    <application
        android:label="RC-N1C Flight Bridge"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter"/>
        </activity>

        <!-- Existing Wi-Fi -> PC dashboard/bridge. Kept intact. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- New local RC -> Android virtual gamepad dashboard. -->
        <activity
            android:name=".GamepadActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <service
            android:name=".GamepadBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>

        <!-- Shizuku bootstrap provider. The uinput service itself is spawned as a user-service. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.drone.rcn1cbridge.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.drone.rcn1cbridge.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true"/>
    </application>
</manifest>
